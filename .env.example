# Local application settings only. Copy to .env; never commit real secrets.
CLAIMOPS_ENV=local
CLAIMOPS_AWS_REGION=af-south-1
CLAIMOPS_TIMEZONE=Africa/Nairobi
CLAIMOPS_API_BASE_URL=http://localhost:8000/api/v1
CLAIMOPS_AUTH_MODE=local
CLAIMOPS_LOG_LEVEL=INFO
CLAIMOPS_REPOSITORY=memory
CLAIMOPS_SLA_AT_RISK_MINUTES=30
CLAIMOPS_SLA_WATCH_MINUTES=60

# Local development table/bucket names (created in later phases)
CLAIMOPS_TABLE_NAME=claimops-local
CLAIMOPS_REPORT_BUCKET=claimops-local-reports

# Frontend-exposed values must use the VITE_ prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AUTH_MODE=local
